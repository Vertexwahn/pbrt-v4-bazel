common --enable_platform_specific_config

build --incompatible_strict_action_env

# pbrt-v4 requires C++17.
build:linux --cxxopt=-std=c++17
build:linux --host_cxxopt=-std=c++17
build:macos --cxxopt=-std=c++17
build:macos --host_cxxopt=-std=c++17
build:windows --cxxopt=/std:c++17
build:windows --host_cxxopt=/std:c++17

# MSVC: report the real __cplusplus value, allow large object files and enable
# the conforming preprocessor (required by NanoVDB / OpenEXR headers).
build:windows --cxxopt=/Zc:__cplusplus
build:windows --host_cxxopt=/Zc:__cplusplus
build:windows --cxxopt=/Zc:preprocessor
build:windows --host_cxxopt=/Zc:preprocessor
build:windows --cxxopt=/bigobj
build:windows --host_cxxopt=/bigobj
build:windows --copt=/utf-8
build:windows --host_copt=/utf-8

# Tests need the DLL search path on Windows.
test:windows --test_env=PATH

test --test_output=errors

try-import %workspace%/user.bazelrc
