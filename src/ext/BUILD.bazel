"""Third-party sources that are vendored directly in the pbrt-v4 tree."""

load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# OpenGL loader generated by https://glad.dav1d.de/ - resolves GL entry points
# at runtime, so no OpenGL import library is required at link time.
cc_library(
    name = "glad",
    srcs = ["glad/src/glad.c"],
    hdrs = [
        "glad/include/KHR/khrplatform.h",
        "glad/include/glad/glad.h",
    ],
    includes = ["glad/include"],
    linkopts = select({
        "@platforms//os:linux": ["-ldl"],
        "//conditions:default": [],
    }),
)

# RPly - PLY file reader/writer, https://w3.impa.br/~diego/software/rply
cc_library(
    name = "rply",
    srcs = ["rply/rply.cpp"],
    hdrs = ["rply/rply.h"],
    strip_include_prefix = "/src/ext",
    deps = ["@zlib"],
)

# NVIDIA FLIP image difference metric, https://github.com/NVlabs/flip
cc_library(
    name = "flip",
    srcs = ["flip/flip.cpp"],
    hdrs = ["flip/flip.h"],
    # flip.cpp only defines _USE_MATH_DEFINES when WIN32 is set, which CMake
    # does implicitly for MSVC but Bazel does not.
    local_defines = select({
        "@platforms//os:windows": ["_USE_MATH_DEFINES"],
        "//conditions:default": [],
    }),
    strip_include_prefix = "/src/ext/flip",
)

# Hosek-Wilkie analytic sky model, https://cgg.mff.cuni.cz/projects/SkylightModelling/
cc_library(
    name = "skymodel",
    srcs = ["skymodel/ArHosekSkyModel.c"],
    hdrs = [
        "skymodel/ArHosekSkyModel.h",
        "skymodel/ArHosekSkyModelData_CIEXYZ.h",
        "skymodel/ArHosekSkyModelData_RGB.h",
        "skymodel/ArHosekSkyModelData_Spectral.h",
    ],
    strip_include_prefix = "/src/ext",
)
