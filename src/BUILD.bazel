"""pbrt-v4 - physically based rendering system."""

load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_import.bzl", "cc_import")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_cuda//cuda:defs.bzl", "cuda_library", "requires_cuda")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "dbg",
    values = {"compilation_mode": "dbg"},
)

bool_flag(
    name = "gpu",
    build_setting_default = False,
)

config_setting(
    name = "gpu_enabled",
    flag_values = {":gpu": "true"},
)

GPU_TARGET_COMPATIBILITY = requires_cuda() + select({
    ":gpu_enabled": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

# Mirrors PBRT_DEFINITIONS from the CMake build (the results of the
# check_cxx_source_compiles() probes are hard-coded per platform here).
PBRT_DEFINES = ["PTEX_STATIC"] + select({
    "@platforms//os:windows": [
        "PBRT_IS_WINDOWS",
        "PBRT_IS_MSVC",
        "NOMINMAX",
        "_CRT_SECURE_NO_WARNINGS",
        "_ENABLE_EXTENDED_ALIGNED_STORAGE",
        "PBRT_HAS_INTRIN_H",
        "PBRT_HAVE__ALIGNED_MALLOC",
        "PBRT_NOINLINE=__declspec(noinline)",
        "PBRT_RESTRICT=__restrict",
    ],
    "@platforms//os:macos": [
        "PBRT_IS_OSX",
        "PBRT_HAVE_MMAP",
        "PBRT_HAVE_POSIX_MEMALIGN",
        "PBRT_NOINLINE=__attribute__((noinline))",
        "PBRT_RESTRICT=__restrict__",
    ],
    "//conditions:default": [
        "PBRT_IS_LINUX",
        "PBRT_HAVE_MMAP",
        "PBRT_HAVE_POSIX_MEMALIGN",
        "PBRT_NOINLINE=__attribute__((noinline))",
        "PBRT_RESTRICT=__restrict__",
    ],
}) + select({
    ":gpu_enabled": ["PBRT_BUILD_GPU_RENDERER"],
    "//conditions:default": [],
}) + select({
    ":dbg": ["PBRT_DEBUG_BUILD"],
    "//conditions:default": [],
})

PBRT_LINKOPTS = select({
    "@platforms//os:windows": [
        "-DEFAULTLIB:dbghelp.lib",
        "-DEFAULTLIB:wsock32.lib",
        "-DEFAULTLIB:ws2_32.lib",
    ],
    "@platforms//os:linux": [
        "-pthread",
        "-ldl",
        "-rdynamic",
    ],
    "//conditions:default": ["-pthread"],
})

# ---------------------------------------------------------------------------
# Code generators
# ---------------------------------------------------------------------------

# Structure-of-arrays code generator; emits the generated header on stdout.
cc_binary(
    name = "soac",
    srcs = ["pbrt/cmd/soac.cpp"],
)

genrule(
    name = "pbrt_soa_header",
    srcs = ["pbrt/pbrt.soa"],
    outs = ["pbrt_soa.h"],
    cmd = "$(execpath :soac) $(execpath pbrt/pbrt.soa) > $@",
    cmd_bat = "$(execpath :soac) $(execpath pbrt/pbrt.soa) > $@",
    tools = [":soac"],
)

genrule(
    name = "wavefront_workitems_soa_header",
    srcs = ["pbrt/wavefront/workitems.soa"],
    outs = ["wavefront_workitems_soa.h"],
    cmd = "$(execpath :soac) $(execpath pbrt/wavefront/workitems.soa) > $@",
    cmd_bat = "$(execpath :soac) $(execpath pbrt/wavefront/workitems.soa) > $@",
    tools = [":soac"],
)

# Fits the RGB -> reflectance spectrum tables used by pbrt's colour handling.
cc_binary(
    name = "rgb2spec_opt",
    srcs = ["pbrt/cmd/rgb2spec_opt.cpp"],
    linkopts = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["-pthread"],
    }),
)

RGB_TO_SPECTRUM_TABLES = {
    "aces": "ACES2065_1",
    "dci_p3": "DCI_P3",
    "rec2020": "REC2020",
    "srgb": "sRGB",
}

[
    genrule(
        name = "rgbspectrum_%s_source" % name,
        outs = ["rgbspectrum_%s.cpp" % name],
        cmd = "$(execpath :rgb2spec_opt) 64 $@ " + colorspace,
        cmd_bat = "$(execpath :rgb2spec_opt) 64 $@ " + colorspace,
        tools = [":rgb2spec_opt"],
    )
    for name, colorspace in RGB_TO_SPECTRUM_TABLES.items()
]

# ---------------------------------------------------------------------------
# pbrt library
# ---------------------------------------------------------------------------

CUDA_COPTS = ["-std=c++17"] + select({
    # CCCL requires MSVC's standard-conforming preprocessor.
    "@platforms//os:windows": ["-Xcompiler=/Zc:preprocessor"],
    "//conditions:default": [],
})

# rules_cuda's default Windows runtime (cudart.lib) loads cudart64_13.dll at run
# time, which is not available without a system-wide CUDA installation. Like
# the CMake build, link the static runtime instead; .bazelrc selects this target
# through --@rules_cuda//cuda:runtime on Windows.
cc_import(
    name = "cudart_static_windows",
    static_library = "@cuda_cudart_windows_x86_64_13_2_2//:cudart/lib/x64/cudart_static.lib",
    target_compatible_with = ["@platforms//os:windows"],
)

cc_library(
    name = "cuda_runtime_static_windows",
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        ":cudart_static_windows",
        "@cuda//:cccl_headers",
        "@cuda//:crt_headers",
        "@cuda//:cudadevrt_lib",
        "@cuda//:cudart_headers",
        "@cuda//:nvcc_headers",
    ],
)

