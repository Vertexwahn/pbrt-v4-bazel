cuda_library(
    name = "pbrt_gpu_lib",
    srcs = GPU_COMPILED_SOURCES + [":pbrt_embedded_ptx"],
    hdrs = glob(["pbrt/**/*.h"]) + [
        "pbrt_soa.h",
        "wavefront_workitems_soa.h",
    ],
    copts = CUDA_COPTS + select({
        "@platforms//os:linux": [
            "-Iexternal/rules_cuda++toolchain+cuda_cccl_linux_x86_64_13_2_2/cccl/include/cccl",
        ],
        "@platforms//os:windows": [
            "-Iexternal/rules_cuda++toolchain+cuda_cccl_windows_x86_64_13_2_2/cccl/include/cccl",
        ],
        "//conditions:default": [],
    }),
    defines = PBRT_DEFINES,
    includes = ["."],
    rdc = True,
    target_compatible_with = GPU_TARGET_COMPATIBILITY,
    deps = PBRT_DEPS + [
        "@vibeoptix//:vibeoptix",
        "@cuda",
        "@nanovdb_headers//:cuda_compat",
    ],
    alwayslink = True,
)

genrule(
    name = "pbrt_embedded_ptx",
    srcs = [
        "pbrt/gpu/optix/optix.cu",
        "@vibeoptix//:include/vibeoptix/api.h",
        "@vibeoptix//:include/vibeoptix/device_api.cuh",
        "@vibeoptix//:include/vibeoptix/device_intrinsics.cuh",
        "@vibeoptix//:include/vibeoptix/glibc_cuda_compat/bits/mathcalls.h",
        "pbrt/util/color.cpp",
        "pbrt/util/colorspace.cpp",
        "pbrt/util/log.cpp",
        "pbrt/util/noise.cpp",
        "pbrt/util/spectrum.cpp",
        "pbrt/util/transform.cpp",
        ":pbrt_soa_header",
        ":wavefront_workitems_soa_header",
        "@cuda//:cuda_all_files",
    ] + glob(["pbrt/**/*.h"]) + [
        "@nanovdb_headers//:headers",
    ],
    outs = [
        "pbrt_embedded_ptx.cpp",
        "pbrt_optix.ptx",
    ],
    cmd = """
CICC_PATH=external/rules_cuda++toolchain+cuda_nvvm_linux_x86_64_13_2_2/nvvm/nvvm/bin \
NVVMIR_LIBRARY_DIR=external/rules_cuda++toolchain+cuda_nvvm_linux_x86_64_13_2_2/nvvm/nvvm/libdevice \
$(execpath @cuda//:nvcc) --ptx -std=c++17 -arch=compute_75 --extended-lambda --expt-relaxed-constexpr \
  -DPTEX_STATIC -DPBRT_BUILD_GPU_RENDERER -DPBRT_IS_LINUX \
  -DPBRT_HAVE_MMAP -DPBRT_HAVE_POSIX_MEMALIGN \
  -DPBRT_NOINLINE=__attribute__\\(\\(noinline\\)\\) \
  -DPBRT_RESTRICT=__restrict__ \
    -I external/rules_cuda++toolchain+cuda_cudart_linux_x86_64_13_2_2/cudart/include \
    -I external/rules_cuda++toolchain+cuda_nvcc_linux_x86_64_13_2_2/nvcc/include \
    -I external/rules_cuda++toolchain+cuda_cccl_linux_x86_64_13_2_2/cccl/include \
    -I external/rules_cuda++toolchain+cuda_cccl_linux_x86_64_13_2_2/cccl/include/cccl \
    -I external/rules_cuda++toolchain+cuda_crt_linux_x86_64_13_2_2/crt/include \
  -I $$(dirname $$(dirname $(execpath @vibeoptix//:include/vibeoptix/device_api.cuh))) \
  -I src -I $(@D) -I external/+http_archive+nanovdb_headers/nanovdb \
  $(execpath pbrt/gpu/optix/optix.cu) -o $(@D)/pbrt_optix.ptx &&
$(execpath @cuda//:bin2c) --name PBRT_EMBEDDED_PTX \
  $(@D)/pbrt_optix.ptx > $(@D)/pbrt_embedded_ptx.cpp
""",
    cmd_bat = "$(execpath pbrt/cmd/pbrt_gpu_ptx.bat) $(execpath @cuda//:nvcc) $(execpath @cuda//:bin2c) $(execpath pbrt/gpu/optix/optix.cu) $(@D)/pbrt_optix.ptx $(@D)/pbrt_embedded_ptx.cpp $(execpath @vibeoptix//:include/vibeoptix/device_api.cuh)",
    tools = [
        "pbrt/cmd/pbrt_gpu_ptx.bat",
        "@cuda//:bin2c",
        "@cuda//:nvcc",
    ],
    target_compatible_with = GPU_TARGET_COMPATIBILITY,
)

cc_library(
    name = "pbrt_lib",
    srcs = select({
        ":gpu_enabled": glob(
            [
                "pbrt/*.cpp",
                "pbrt/cpu/*.cpp",
                "pbrt/util/*.cpp",
                "pbrt/wavefront/*.cpp",
            ],
            exclude = [
                "**/*_test.cpp",
                "pbrt/util/stbimage.cpp",
            ] + GPU_COMPILED_SOURCES,
        ),
        "//conditions:default": glob(
            [
                "pbrt/*.cpp",
                "pbrt/cpu/*.cpp",
                "pbrt/util/*.cpp",
                "pbrt/wavefront/*.cpp",
            ],
            exclude = [
                "**/*_test.cpp",
                "pbrt/util/stbimage.cpp",
            ],
        ),
    }) + select({
        ":gpu_enabled": [],
        "//conditions:default": ["pbrt/cmd/pspec_gpu.cpp"],
    }) + ["rgbspectrum_%s.cpp" % name for name in RGB_TO_SPECTRUM_TABLES],
    hdrs = glob(["pbrt/**/*.h"]) + [
        "pbrt_soa.h",
        "wavefront_workitems_soa.h",
    ],
    defines = PBRT_DEFINES,
    includes = ["."],
    linkopts = PBRT_LINKOPTS,
    deps = PBRT_DEPS + select({
        ":gpu_enabled": [":pbrt_gpu_lib"],
        "//conditions:default": [],
    }),
    alwayslink = select({
        ":gpu_enabled": True,
        "//conditions:default": False,
    }),
)

