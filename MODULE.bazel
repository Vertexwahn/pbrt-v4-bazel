"""pbrt-v4 - https://github.com/mmp/pbrt-v4"""

module(
    name = "pbrt",
    version = "4.0.0",
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.25")

bazel_dep(name = "glfw", version = "3.4.0.bcr.3")
bazel_dep(name = "googletest", version = "1.18.0.bcr.1")
bazel_dep(name = "libdeflate", version = "1.26")
bazel_dep(name = "lodepng", version = "0.0.0-20250506-17d08dd")
bazel_dep(name = "openexr", version = "3.5.1")
bazel_dep(name = "openvdb", version = "11.0.0.bcr.1")
bazel_dep(name = "stb", version = "0.0.0-20251026-f1c79c0")
bazel_dep(name = "zlib", version = "1.3.2")

# ---------------------------------------------------------------------------
# Dependencies that are not (yet) available in the Bazel Central Registry.
# These overlays are meant to be upstreamed to the BCR; once that happened the
# corresponding http_archive can be replaced by a plain bazel_dep.
# ---------------------------------------------------------------------------

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "ptex",
    build_file = "//third_party:ptex.BUILD.bazel",
    integrity = "sha256-Q1qi7heB/ySFm9KCt2Fr+uuGyhBgSxPQha2oqnYCrSc=",
    strip_prefix = "ptex-2.4.3",
    url = "https://github.com/wdas/ptex/archive/refs/tags/v2.4.3.tar.gz",
)

# Header-only path handling library by Wenzel Jakob. Upstream has no releases.
http_archive(
    name = "filesystem",
    build_file = "//third_party:filesystem.BUILD.bazel",
    integrity = "sha256-+jgAuRxJlR0L5zlnFvahkbBUDHzdoJtCP+ekIXByiak=",
    strip_prefix = "filesystem-c5f9de30142453eb3c6fe991e82dfc2583373116",
    url = "https://github.com/wjakob/filesystem/archive/c5f9de30142453eb3c6fe991e82dfc2583373116.tar.gz",
)

# Single-header QOI image codec. Upstream has no releases.
http_archive(
    name = "qoi",
    build_file = "//third_party:qoi.BUILD.bazel",
    integrity = "sha256-t2O5uOQA9JQeltmD/Lj4XBYZqFSuKwZF/oP9PpO+1ZA=",
    strip_prefix = "qoi-028c75fd26e5e0758c7c711216c00404994c1ad3",
    url = "https://github.com/phoboslab/qoi/archive/028c75fd26e5e0758c7c711216c00404994c1ad3.tar.gz",
)

# utf8proc IS in the BCR, but utf8proc@2.11.0 ships a BUILD file that uses the
# native cc_library rule without a load() statement, which Bazel 9 rejects.
http_archive(
    name = "utf8proc",
    build_file = "//third_party:utf8proc.BUILD.bazel",
    integrity = "sha256-wkN5tfoKQpofmj/CO0SnXysUGjTAkUalKaVdIKWAgHA=",
    strip_prefix = "utf8proc-2.11.0",
    url = "https://github.com/JuliaStrings/utf8proc/archive/refs/tags/v2.11.0.tar.gz",
)

# Same story as utf8proc: double-conversion@3.3.1 relies on the removed native
# cc_library rule.
http_archive(
    name = "double-conversion",
    build_file = "//third_party:double-conversion.BUILD.bazel",
    integrity = "sha256-/lSQEFXHEwLc3Fw8y+JlpsGRl483Yc4UFNCJXWsOqQ4=",
    strip_prefix = "double-conversion-3.3.1",
    url = "https://github.com/google/double-conversion/archive/refs/tags/v3.3.1.tar.gz",
)
